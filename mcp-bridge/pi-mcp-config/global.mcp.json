{
  "mcpServers": {
    "godot": {
      "command": "node",
      "args": [
        "<path-to-godot-skills>/mcp-bridge/godot-mcp-server/dist/index.js"
      ],
      "env": {
        "GODOT_MCP_TOKEN": "<per-session token generated by the Godot MCP plugin>"
      },
      "transportType": "stdio"
    }
  }
}
